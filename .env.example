# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Backpack Exchange API
# Backpack Exchange > Settings > API Keys 에서 발급
# BP_API_KEY  : ed25519 공개키 (base64, Backpack에 등록한 값)
# BP_API_SECRET : ed25519 비밀키 시드 (base64, 32바이트)
BP_API_KEY=your_ed25519_public_key_base64
BP_API_SECRET=your_ed25519_private_key_seed_base64

# DCA 설정
DCA_SYMBOL=BP_USDC          # 거래 심볼
DCA_AMOUNT_USDC=10          # 일일 매수 금액 (USDC)

# 스케줄 (AEST = UTC+10, 브리즈번/시드니 기준)
DCA_TIME_AEST=09:00         # 매일 DCA 실행 시각

# 안전 설정
MIN_USDC_BALANCE=20         # 최소 USDC 잔고 버퍼 (이 금액 미만이면 DCA 건너뜀)

# 주문 실행 튜닝
ORDER_RETRY_INTERVAL_SEC=30  # 재시도 간격 (초)
ORDER_PRICE_STEP_PCT=0.1     # 재시도마다 가격 상승률 (%)
ORDER_MAX_RETRIES=10         # 최대 재시도 횟수

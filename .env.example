# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Backpack Exchange API
# Get from: Backpack Exchange > Settings > API Keys
# BP_API_KEY    : ed25519 public key (base64, the key you registered on Backpack)
# BP_API_SECRET : ed25519 private key seed (base64, 32 bytes)
BP_API_KEY=your_ed25519_public_key_base64
BP_API_SECRET=your_ed25519_private_key_seed_base64

# DCA Configuration
DCA_SYMBOL=BP_USDC           # Trading pair
DCA_AMOUNT_USDC=10           # Daily buy amount in USDC

# Schedule (AEST = UTC+10, Brisbane/Sydney time)
DCA_TIME_AEST=09:00          # Daily DCA execution time

# Safety
MIN_USDC_BALANCE=20          # Minimum USDC buffer (skip DCA if below this)

# Order Execution Tuning
ORDER_RETRY_INTERVAL_SEC=30  # Seconds between retry attempts
ORDER_PRICE_STEP_PCT=0.1     # Price increase per retry (%)
ORDER_MAX_RETRIES=10         # Maximum retry attempts
